{
  extends: [
    'config:recommended',
    'group:all',
  ],
  schedule: 'before 5am every weekday',
  argocd: {
    managerFilePatterns: [
      '/src/applications/.*/deploy/argocd/application.*\\.yaml/',
    ],
  },
  // Plain Kubernetes manifests carrying a digest-pinned `image:`. Without this
  // the pin in src/applications/kamerplanter/deploy/delivery-check/cronjob.yaml
  // would be unmanaged and would silently rot, which is the opposite of the
  // image-pinning invariant this repository states for that very application.
  kubernetes: {
    managerFilePatterns: [
      '/src/applications/.*/deploy/.*/cronjob\\.yaml/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Yet another regex',
      managerFilePatterns: [
        '/src/applications/.*/deploy/argocd/application.*\\.yaml/',
      ],
      matchStrings: [
        'repository:\\s?"?(?<depName>[^\\s"]*)"?\\s*?tag:\\s?"?(?<currentValue>[^\\s"]*)"?',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
